---
import Layout from '../layouts/Layout.astro';

const features = [
  {
    title: "ゼロJSデフォルトアーキテクチャ",
    desc: "必要な部分以外には一切JavaScriptを出力しないため、ネットワーク負荷を最小限に抑え、爆速のFirst Contentful Paintを実現します。",
    icon: `<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>`,
    color: "pink",
    tag: "パフォーマンス"
  },
  {
    title: "アイランドアーキテクチャ",
    desc: "ページ内の動的UIコンポーネントを独立した「アイランド」として分離。ページロードをブロックせず並列かつオンデマンドでハイドレーションします。",
    icon: `<circle cx="12" cy="12" r="10"></circle><path d="m4.93 4.93 4.24 4.24"></path><path d="m14.83 9.17 4.24-4.24"></path><path d="m14.83 14.83 4.24 4.24"></path><path d="m9.17 14.83-4.24 4.24"></path>`,
    color: "purple",
    tag: "コアテクノロジー"
  },
  {
    title: "マルチフレームワーク共存",
    desc: "React、Vue、Svelte、Solidなど、好みのフレームワークを同一プロジェクト内で共存・統合可能。最適なツールを自由に選択できます。",
    icon: `<rect width="18" height="18" x="3" y="3" rx="2"></rect><path d="M3 9h18"></path><path d="M9 21V9"></path>`,
    color: "cyan",
    tag: "エコシステム"
  },
  {
    title: "Content Collections による型安全",
    desc: "MarkdownやMDXのFrontmatterをZodスキーマで自動検証。ビルド時に型エラーを検出し、安全かつ迅速なコンテンツ編集を可能にします。",
    icon: `<path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"></path><path d="M6 6h10"></path><path d="M6 10h10"></path>`,
    color: "purple",
    tag: "開発体験"
  },
  {
    title: "自動画像最適化 ＆ WebP変換",
    desc: "画像を自動で次世代フォーマット（WebP/AVIF）へ変換・リサイズし、レイアウトシフト（CLS）を防止するサイズ指定を自動付与します。",
    icon: `<rect width="18" height="18" x="3" y="3" rx="2"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path>`,
    color: "cyan",
    tag: "アセット管理"
  },
  {
    title: "マルチプラットフォーム即時デプロイ",
    desc: "Cloudflare Pages、Vercel、Netlify、AWSなど、主要なエッジ環境や静的ホスティングへ設定レスで瞬時にデプロイ可能です。",
    icon: `<path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"></path><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"></path>`,
    color: "pink",
    tag: "インフラ連携"
  }
];

const comparisons = [
  { item: "初回ロード時間 (TTFB & FCP)", astro: "0.1秒未満 (静的最適化)", spa: "1.5〜3.0秒 (巨大バンドル)" },
  { item: "JavaScript転送量", astro: "0KB 〜 最小限のアイランド", spa: "300KB 〜 2MB+" },
  { item: "SEO & OGP親和性", astro: "完全ネイティブ対応 (完全なHTML)", spa: "SSR設定やプリレンダリング必須" },
  { item: "Lighthouse Performance", astro: "常時 95〜100点", spa: "50〜70点前後になりがち" },
  { item: "フレームワークの自由度", astro: "React, Vue, Svelte等を混在可能", spa: "選定した1つに強固にロックイン" }
];
---

<Layout 
  title="機能・特徴紹介 - AstroSphere" 
  description="AstroSphereが提供する超高速アーキテクチャ、アイランドモデル、型安全なコンテンツ管理などの機能詳細をご紹介します。"
>
  <div class="features-page">
    <!-- ページヘッダー -->
    <header class="page-header">
      <div class="container text-center">
        <span class="badge">機能と特徴</span>
        <h1 class="page-title">ハイパフォーマンスを実現する<br /><span class="gradient-text">妥協なき機能群</span></h1>
        <p class="page-desc">
          ユーザー体験と開発効率の双方を最高レベルに引き上げる、先進のWebスタックを標準装備。
        </p>
      </div>
    </header>

    <!-- メイン機能グリッド -->
    <section class="container features-section">
      <div class="features-grid">
        {features.map((f) => (
          <article class="card feature-card">
            <div class="card-top">
              <div class={`feature-icon icon-${f.color}`}>
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={f.icon} />
              </div>
              <span class="category-pill">{f.tag}</span>
            </div>
            <h2 class="card-title">{f.title}</h2>
            <p class="card-desc">{f.desc}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- 比較セクション -->
    <section class="container comparison-section">
      <div class="section-heading text-center">
        <span class="badge">アーキテクチャ比較</span>
        <h2 class="sub-title">従来のSPAとAstroSphereの違い</h2>
      </div>

      <div class="comparison-table-wrapper">
        <table class="comparison-table">
          <thead>
            <tr>
              <th>項目</th>
              <th class="highlight-col">AstroSphere (Astro)</th>
              <th>一般的なSPA (Single Page App)</th>
            </tr>
          </thead>
          <tbody>
            {comparisons.map((row) => (
              <tr>
                <td class="col-item">{row.item}</td>
                <td class="col-astro highlight-col">
                  <span class="check-icon">✓</span> {row.astro}
                </td>
                <td class="col-spa">{row.spa}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- 導入ステップ -->
    <section class="container steps-section">
      <div class="section-heading text-center">
        <span class="badge">導入の流れ</span>
        <h2 class="sub-title">導入からローンチまでの3ステップ</h2>
      </div>

      <div class="steps-grid">
        <div class="step-card">
          <div class="step-num">01</div>
          <h3 class="step-title">ヒアリング & サイト設計</h3>
          <p class="step-desc">サイトの目的、ターゲット層、必要機能に合わせたコンポーネント構成を設計します。</p>
        </div>
        <div class="step-card">
          <div class="step-num">02</div>
          <h3 class="step-title">モダンUI & アイランド構築</h3>
          <p class="step-desc">デザインシステムに基づく洗練されたレイアウトと、軽量なインタラクションを構築します。</p>
        </div>
        <div class="step-card">
          <div class="step-num">03</div>
          <h3 class="step-title">最適化検証 & 即時ローンチ</h3>
          <p class="step-desc">Lighthouseスコア100点とレスポンシブ表示を確認し、お好みのインフラへ即座に公開します。</p>
        </div>
      </div>
    </section>

    <!-- ボトムCTA -->
    <section class="container bottom-cta-section">
      <div class="cta-box text-center">
        <h2>実際のパフォーマンスを体感してみませんか？</h2>
        <p>詳細なデモのご案内やお見積もりのご相談を随時承っております。</p>
        <a href="/contact" class="btn btn-primary">お問い合わせ・無料デモ予約</a>
      </div>
    </section>
  </div>
</Layout>

<style>
  .features-page {
    padding-bottom: 80px;
  }

  .text-center {
    text-align: center;
  }

  .page-header {
    padding: 80px 0 50px;
  }

  .page-title {
    font-size: 2.2rem;
    margin: 16px 0;
  }

  @media (min-width: 768px) {
    .page-title {
      font-size: 3.2rem;
    }
  }

  .page-desc {
    color: var(--text-muted);
    font-size: 1.1rem;
    max-width: 620px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* 機能グリッド */
  .features-section {
    margin-bottom: 90px;
  }

  .features-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  @media (min-width: 640px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .features-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .feature-card {
    display: flex;
    flex-direction: column;
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
  }

  .feature-icon {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .icon-purple {
    background: rgba(99, 102, 241, 0.15);
    border: 1px solid rgba(99, 102, 241, 0.3);
    color: #a5b4fc;
  }

  .icon-pink {
    background: rgba(236, 72, 153, 0.15);
    border: 1px solid rgba(236, 72, 153, 0.3);
    color: #f472b6;
  }

  .icon-cyan {
    background: rgba(6, 182, 212, 0.15);
    border: 1px solid rgba(6, 182, 212, 0.3);
    color: #22d3ee;
  }

  .category-pill {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-dim);
    background: rgba(255, 255, 255, 0.05);
    padding: 4px 10px;
    border-radius: var(--radius-full);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .card-title {
    font-size: 1.25rem;
    margin-bottom: 12px;
  }

  .card-desc {
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.65;
  }

  /* 比較テーブル */
  .comparison-section {
    margin-bottom: 90px;
  }

  .section-heading {
    margin-bottom: 40px;
  }

  .sub-title {
    font-size: 1.8rem;
    margin-top: 14px;
  }

  .comparison-table-wrapper {
    overflow-x: auto;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    backdrop-filter: blur(12px);
  }

  .comparison-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    min-width: 600px;
  }

  .comparison-table th, 
  .comparison-table td {
    padding: 18px 24px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    font-size: 0.95rem;
  }

  .comparison-table th {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.02);
  }

  .highlight-col {
    background: rgba(99, 102, 241, 0.06);
    color: #ffffff;
    font-weight: 600;
  }

  .col-item {
    font-weight: 600;
    color: var(--text-main);
  }

  .col-spa {
    color: var(--text-dim);
  }

  .check-icon {
    color: #4ade80;
    margin-right: 6px;
    font-weight: 800;
  }

  /* ステップセクション */
  .steps-section {
    margin-bottom: 90px;
  }

  .steps-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  @media (min-width: 768px) {
    .steps-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .step-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 32px 24px;
    position: relative;
    backdrop-filter: blur(8px);
  }

  .step-num {
    font-family: var(--font-heading);
    font-size: 2.5rem;
    font-weight: 800;
    background: var(--primary-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    line-height: 1;
    margin-bottom: 16px;
  }

  .step-title {
    font-size: 1.2rem;
    margin-bottom: 10px;
  }

  .step-desc {
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  /* ボトムCTA */
  .cta-box {
    background: linear-gradient(135deg, rgba(99, 102, 241, 0.15), rgba(236, 72, 153, 0.1));
    border: 1px solid rgba(99, 102, 241, 0.3);
    border-radius: var(--radius-lg);
    padding: 60px 24px;
  }

  .cta-box h2 {
    font-size: 1.8rem;
    margin-bottom: 14px;
  }

  .cta-box p {
    color: var(--text-muted);
    max-width: 500px;
    margin: 0 auto 28px;
    font-size: 1rem;
    line-height: 1.6;
  }
</style>
