---
import Layout from '../layouts/Layout.astro';

const faqs = [
  {
    q: "AstroSphereのデモサイトはどのように利用できますか？",
    a: "本サイトはAstroの基本機能（ルーティング、コンポーネント化、アイランド、CSSスタイリング）を網羅したテンプレートデモです。ソースコードを自由にカスタマイズして自社プロダクトのベースとしてご利用いただけます。"
  },
  {
    q: "ReactやVueのコンポーネントは追加できますか？",
    a: "はい、可能です。`npx astro add react` や `npx astro add vue` を実行するだけで、同一プロジェクト内に既存のReact/Vueコンポーネントを即座に導入・利用できます。"
  },
  {
    q: "デプロイ先はどこがおすすめですか？",
    a: "Cloudflare PagesやVercel、Netlifyなどのモダンホスティングが最も推奨されます。Gitリポジトリと連携するだけで、ゼロ設定で自動ビルド＆全世界エッジ配信が実現します。"
  },
  {
    q: "商用利用やカスタマイズは可能ですか？",
    a: "はい、自由に改変・商用利用いただけます。ライセンス規定に準じて柔軟にご活用ください。"
  }
];
---

<Layout 
  title="お問い合わせ - AstroSphere" 
  description="AstroSphereへのデモ予約、技術導入相談、ご質問などのお問い合わせ窓口です。"
>
  <div class="contact-page">
    <header class="page-header text-center">
      <div class="container">
        <span class="badge">コンタクト</span>
        <h1 class="page-title">お問い合わせ・<br /><span class="gradient-text">無料デモのご予約</span></h1>
        <p class="page-desc">
          プロジェクトの課題や導入のご相談など、専任エンジニアが迅速にご返答いたします。
        </p>
      </div>
    </header>

    <div class="container main-content-grid">
      <!-- フォームエリア -->
      <div class="form-wrapper card">
        <div id="form-container">
          <h2 class="form-title">メッセージ送信フォーム</h2>
          <form id="contact-form" class="contact-form">
            <div class="form-group">
              <label for="name" class="form-label">お名前 <span class="required">*</span></label>
              <input type="text" id="name" name="name" required placeholder="例：山田 太郎" class="form-input" />
            </div>

            <div class="form-group">
              <label for="email" class="form-label">メールアドレス <span class="required">*</span></label>
              <input type="email" id="email" name="email" required placeholder="name@example.com" class="form-input" />
            </div>

            <div class="form-group">
              <label for="type" class="form-label">お問い合わせ種別</label>
              <select id="type" name="type" class="form-select">
                <option value="demo">無料オンラインデモの予約</option>
                <option value="support">導入サポート・お見積もり</option>
                <option value="technical">技術的なご質問</option>
                <option value="other">その他</option>
              </select>
            </div>

            <div class="form-group">
              <label for="message" class="form-label">お問い合わせ内容 <span class="required">*</span></label>
              <textarea id="message" name="message" rows="5" required placeholder="ご相談内容を詳しくご記入ください..." class="form-textarea"></textarea>
            </div>

            <div class="form-checkbox">
              <input type="checkbox" id="agree" required />
              <label for="agree">プライバシーポリシーに同意して送信する</label>
            </div>

            <button type="submit" id="submit-btn" class="btn btn-primary submit-btn">
              <span>送信する</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="22" y1="2" x2="11" y2="13"></line>
                <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
              </svg>
            </button>
          </form>
        </div>

        <!-- 送信完了トースト・メッセージ -->
        <div id="success-message" class="success-box" style="display: none;">
          <div class="success-icon">✓</div>
          <h3>お問い合わせを受け付けました</h3>
          <p>
            メッセージを送信いただきありがとうございます。<br />
            通常24時間以内に担当者よりご指定のメールアドレスへご連絡差し上げます。
          </p>
          <button id="reset-form-btn" class="btn btn-secondary">もう一度送信する</button>
        </div>
      </div>

      <!-- サイドバー：インフォメーション & FAQ -->
      <div class="sidebar-wrapper">
        <div class="card info-card">
          <h3 class="info-title">オフィス・サポート情報</h3>
          <div class="info-list">
            <div class="info-item">
              <div class="info-icon">📍</div>
              <div>
                <strong>所在地</strong>
                <p>東京都渋谷区渋谷2-24-12 渋谷スクランブルスクエア</p>
              </div>
            </div>
            <div class="info-item">
              <div class="info-icon">✉️</div>
              <div>
                <strong>メール</strong>
                <p>contact@astrosphere-demo.example</p>
              </div>
            </div>
            <div class="info-item">
              <div class="info-icon">⏰</div>
              <div>
                <strong>受付時間</strong>
                <p>平日 10:00 〜 19:00 (JST)</p>
              </div>
            </div>
          </div>
        </div>

        <!-- FAQアコーディオン -->
        <div class="faq-section">
          <h3 class="faq-heading">よくあるご質問</h3>
          <div class="faq-list">
            {faqs.map((item, index) => (
              <details class="faq-item" id={`faq-${index}`}>
                <summary class="faq-question">
                  <span>{item.q}</span>
                  <span class="faq-toggle-icon">+</span>
                </summary>
                <div class="faq-answer">
                  <p>{item.a}</p>
                </div>
              </details>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const formContainer = document.getElementById('form-container');
  const successBox = document.getElementById('success-message');
  const resetBtn = document.getElementById('reset-form-btn');
  const submitBtn = document.getElementById('submit-btn');

  if (form && formContainer && successBox && submitBtn) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      
      // 送信中ローディング表現
      submitBtn.setAttribute('disabled', 'true');
      submitBtn.innerHTML = '送信中...';

      setTimeout(() => {
        formContainer.style.display = 'none';
        successBox.style.display = 'block';
        form.reset();
        submitBtn.removeAttribute('disabled');
        submitBtn.innerHTML = '<span>送信する</span>';
      }, 700);
    });

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        successBox.style.display = 'none';
        formContainer.style.display = 'block';
      });
    }
  }
</script>

<style>
  .contact-page {
    padding-bottom: 90px;
  }

  .text-center {
    text-align: center;
  }

  .page-header {
    padding: 80px 0 50px;
  }

  .page-title {
    font-size: 2.2rem;
    margin: 16px 0;
  }

  @media (min-width: 768px) {
    .page-title {
      font-size: 3.2rem;
    }
  }

  .page-desc {
    color: var(--text-muted);
    font-size: 1.1rem;
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .main-content-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 36px;
  }

  @media (min-width: 1024px) {
    .main-content-grid {
      grid-template-columns: 1.4fr 1fr;
      align-items: start;
    }
  }

  /* フォーム */
  .form-wrapper {
    padding: 36px;
  }

  .form-title {
    font-size: 1.4rem;
    margin-bottom: 24px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border-subtle);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .form-label {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-main);
  }

  .required {
    color: #f43f5e;
  }

  .form-input, .form-select, .form-textarea {
    width: 100%;
    background: rgba(0, 0, 0, 0.25);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 12px 16px;
    font-family: inherit;
    font-size: 0.95rem;
    color: var(--text-main);
    transition: all 0.2s ease;
  }

  .form-input:focus, .form-select:focus, .form-textarea:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.25);
    background: rgba(0, 0, 0, 0.4);
  }

  .form-select option {
    background: #090d16;
    color: #fff;
  }

  .form-checkbox {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.88rem;
    color: var(--text-muted);
  }

  .form-checkbox input {
    cursor: pointer;
  }

  .submit-btn {
    width: 100%;
    margin-top: 10px;
  }

  /* 完了メッセージ */
  .success-box {
    text-align: center;
    padding: 40px 20px;
  }

  .success-icon {
    width: 64px;
    height: 64px;
    background: rgba(34, 197, 94, 0.15);
    border: 2px solid #22c55e;
    color: #22c55e;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    margin: 0 auto 20px;
  }

  .success-box h3 {
    font-size: 1.5rem;
    margin-bottom: 12px;
  }

  .success-box p {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 28px;
  }

  /* サイドバー */
  .sidebar-wrapper {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .info-card {
    padding: 28px;
  }

  .info-title {
    font-size: 1.15rem;
    margin-bottom: 20px;
  }

  .info-list {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .info-item {
    display: flex;
    gap: 14px;
    font-size: 0.9rem;
  }

  .info-icon {
    font-size: 1.3rem;
  }

  .info-item strong {
    display: block;
    color: var(--text-main);
    margin-bottom: 2px;
  }

  .info-item p {
    color: var(--text-muted);
    line-height: 1.5;
  }

  /* FAQ */
  .faq-heading {
    font-size: 1.25rem;
    margin-bottom: 16px;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .faq-item {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    overflow: hidden;
    transition: background 0.2s ease;
  }

  .faq-item[open] {
    background: var(--bg-surface-hover);
    border-color: rgba(99, 102, 241, 0.3);
  }

  .faq-question {
    padding: 16px 20px;
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--text-main);
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-toggle-icon {
    font-size: 1.2rem;
    color: #818cf8;
    transition: transform 0.2s ease;
  }

  .faq-item[open] .faq-toggle-icon {
    transform: rotate(45deg);
  }

  .faq-answer {
    padding: 0 20px 16px;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--text-muted);
  }
</style>
